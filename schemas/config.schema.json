{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-content.local/schemas/config-v1.json",
  "title": "Video Content Config v1",
  "type": "object",
  "required": ["schema_version", "values"],
  "properties": {
    "schema_version": {
      "const": "video-content/config-v1"
    },
    "values": {
      "type": "object",
      "properties": {
        "opencli": {"type": "string", "minLength": 1},
        "opencli_profile": {"type": "string", "minLength": 1},
        "ytdlp": {"type": "string", "minLength": 1},
        "ffmpeg": {"type": "string", "minLength": 1},
        "videocr": {"type": "string", "minLength": 1},
        "asr_python": {"type": "string", "minLength": 1},
        "qwen_asr_model": {"type": "string", "minLength": 1},
        "qwen_aligner_model": {"type": "string", "minLength": 1},
        "home": {"type": "string", "minLength": 1},
        "opencli_browser_timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "download_retries": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "download_retry_backoff": {
          "type": "string",
          "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?)$"
        },
        "download_cache": {"type": "string", "minLength": 1},
        "media_execution": {
          "enum": ["auto", "serial", "parallel"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

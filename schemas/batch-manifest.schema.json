{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/batch-manifest-v1.json",
  "title": "Video Content Batch Manifest v1",
  "type": "object",
  "required": ["schema_version", "batch_id", "created_at", "updated_at", "intent", "items"],
  "properties": {
    "schema_version": { "const": "video-content/batch-v1" },
    "batch_id": { "type": "string", "pattern": "^batch_[a-f0-9]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "intent": {
      "type": "object",
      "required": ["target_medium", "draft_requested"],
      "properties": {
        "target_medium": { "enum": ["article", "one_page", "card_series", "brief", "script", "custom", "subtitles_only"] },
        "draft_requested": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["item_id", "input", "status", "stages", "created_at", "updated_at"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^item-[0-9]{3,}$" },
        "input": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["video_url", "video_file", "audio_file", "subtitle_file"] },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "status": { "enum": ["pending", "running", "completed", "failed", "blocked"] },
        "stages": {
          "type": "object",
          "required": ["subtitle", "content", "handoff"],
          "properties": {
            "subtitle": { "$ref": "#/$defs/stage" },
            "content": { "$ref": "#/$defs/stage" },
            "handoff": { "$ref": "#/$defs/stage" }
          },
          "additionalProperties": false
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["status", "attempts", "started_at", "finished_at", "artifact", "last_error"],
      "properties": {
        "status": { "enum": ["pending", "running", "completed", "failed", "blocked", "skipped", "not_requested"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" },
        "artifact": { "type": ["string", "null"] },
        "last_error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/content-map-v1.json",
  "title": "Video Content Map v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_manifest_sha256",
    "content_type",
    "summary",
    "coverage",
    "thesis",
    "evidence_refs",
    "speakers",
    "claims",
    "caveats",
    "counterpoints",
    "terms",
    "visual_refs",
    "uncertainties",
    "agent_inferences",
    "sections"
  ],
  "properties": {
    "schema_version": { "const": "video-content/content-map-v1" },
    "project_id": { "type": "string", "pattern": "^content_[a-f0-9]{16}$" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "content_type": {
      "enum": ["argument", "explanation", "tutorial", "interview", "narrative", "mixed"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "thesis": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["text", "claim_ids"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "claim_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/claim_id" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speaker_id", "name", "role"],
        "properties": {
          "speaker_id": { "type": "string", "pattern": "^speaker-[0-9]{4}$" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "caveats": {
      "type": "array",
      "items": { "$ref": "#/$defs/caveat" }
    },
    "counterpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/counterpoint" }
    },
    "terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" }
    },
    "visual_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual_ref" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "agent_inferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/inference" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim_id": { "type": "string", "pattern": "^claim-[0-9]{4}$" },
    "evidence_ref_id": { "type": "string", "pattern": "^evref-[0-9]{4}$" },
    "range": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["mode", "evidence_ids", "analyzed_ranges", "omitted_ranges"],
      "properties": {
        "mode": { "enum": ["full", "partial"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^ev-[0-9]{4}$" }
        },
        "analyzed_ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/range" }
        },
        "omitted_ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/range" }
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "evidence_ref_id",
        "evidence_id",
        "start_ms",
        "end_ms",
        "text",
        "relationship"
      ],
      "properties": {
        "evidence_ref_id": { "$ref": "#/$defs/evidence_ref_id" },
        "evidence_id": { "type": "string", "pattern": "^ev-[0-9]{4}$" },
        "cue_ids": { "type": "array", "items": { "type": "string" } },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string" },
        "relationship": { "enum": ["supports", "context", "conflicts"] },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "kind",
        "importance",
        "attribution",
        "evidence_refs",
        "confidence",
        "source_support",
        "external_verification"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/claim_id" },
        "text": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "fact",
            "definition",
            "explanation",
            "opinion",
            "prediction",
            "recommendation",
            "instruction",
            "example"
          ]
        },
        "importance": { "enum": ["core", "supporting", "context"] },
        "attribution": { "enum": ["speaker", "publisher", "agent_synthesis"] },
        "speaker_id": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "source_support": { "enum": ["direct", "contextual", "contested"] },
        "external_verification": {
          "enum": ["not_checked", "corroborated", "contradicted", "inconclusive"]
        }
      },
      "additionalProperties": false
    },
    "caveat": {
      "type": "object",
      "required": ["caveat_id", "text", "claim_ids", "evidence_refs"],
      "properties": {
        "caveat_id": { "type": "string", "pattern": "^caveat-[0-9]{4}$" },
        "text": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claim_id" } },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        }
      },
      "additionalProperties": false
    },
    "counterpoint": {
      "type": "object",
      "required": ["counterpoint_id", "text", "claim_ids", "evidence_refs"],
      "properties": {
        "counterpoint_id": { "type": "string", "pattern": "^counter-[0-9]{4}$" },
        "text": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claim_id" } },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        }
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["term_id", "term", "meaning", "evidence_refs"],
      "properties": {
        "term_id": { "type": "string", "pattern": "^term-[0-9]{4}$" },
        "term": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        }
      },
      "additionalProperties": false
    },
    "visual_ref": {
      "type": "object",
      "required": ["visual_ref_id", "start_ms", "end_ms", "description", "role"],
      "properties": {
        "visual_ref_id": { "type": "string", "pattern": "^visual-[0-9]{4}$" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "role": { "enum": ["evidence", "explanation", "example", "decoration"] }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["uncertainty_id", "issue", "impact", "claim_ids", "evidence_refs"],
      "properties": {
        "uncertainty_id": { "type": "string", "pattern": "^uncertainty-[0-9]{4}$" },
        "issue": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["low", "medium", "high"] },
        "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claim_id" } },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": ["inference_id", "text", "reason", "evidence_refs"],
      "properties": {
        "inference_id": { "type": "string", "pattern": "^inference-[0-9]{4}$" },
        "text": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref_id" }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_id", "title", "purpose", "claim_ids"],
      "properties": {
        "section_id": { "type": "string", "pattern": "^section-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claim_id" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

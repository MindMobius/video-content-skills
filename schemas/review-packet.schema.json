{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/review-packet-v1.json",
  "title": "Video Subtitle Review Packet v1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "algorithm_version",
    "mode",
    "primary",
    "corroborating",
    "statistics",
    "windows"
  ],
  "properties": {
    "schema_version": {
      "const": "video-subtitle/review-packet-v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^review_[a-f0-9]{16}$"
    },
    "algorithm_version": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "same_language",
        "cross_language"
      ]
    },
    "primary": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "language",
        "cue_count"
      ]
    },
    "corroborating": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "language",
        "cue_count"
      ]
    },
    "statistics": {
      "type": "object",
      "required": [
        "window_count",
        "high_priority_window_count",
        "flagged_ocr_cue_count"
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/window"
      }
    }
  },
  "$defs": {
    "cue": {
      "type": "object",
      "required": [
        "cue_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "properties": {
        "cue_id": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "flags": {
          "type": "array"
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "window_id",
        "start_ms",
        "end_ms",
        "priority",
        "reasons",
        "primary_cues",
        "corroborating_cues"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "pattern": "^rw-[0-9]{4}$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "enum": [
            "normal",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "corroborating_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

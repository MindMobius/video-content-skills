{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/wechat-manuscript-v1.json",
  "title": "WeChat Article Manuscript v1",
  "type": "object",
  "required": ["schema_version", "title", "summary", "source", "blocks"],
  "properties": {
    "schema_version": { "const": "video-content/wechat-manuscript-v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": {
      "type": "object",
      "required": ["title", "creator", "canonical_url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "format": "uri" },
        "disclaimer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/textBlock" },
          { "$ref": "#/$defs/listBlock" },
          { "$ref": "#/$defs/imageBlock" },
          { "$ref": "#/$defs/separatorBlock" }
        ]
      }
    }
  },
  "$defs": {
    "textBlock": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "enum": ["heading", "paragraph", "lead", "key_point", "quote"] },
        "text": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" }
      },
      "additionalProperties": false
    },
    "listBlock": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "path", "source_kind"],
      "properties": {
        "type": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["video_cover", "video_frame"] },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "caption": { "type": "string" }
      },
      "additionalProperties": false
    },
    "separatorBlock": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "separator" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

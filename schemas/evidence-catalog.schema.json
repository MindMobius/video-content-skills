{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/evidence-catalog-v1.json",
  "title": "Video Subtitle Evidence Catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "job_status",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "video-subtitle/evidence-catalog-v1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^sub_[A-Za-z0-9_-]+$"
    },
    "job_status": {
      "type": "string"
    },
    "video": {
      "type": "object"
    },
    "selected_source": {
      "type": [
        "object",
        "null"
      ]
    },
    "review": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "artifact_kind",
          "source",
          "source_kind",
          "layer",
          "selected",
          "available",
          "supports_time_range"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev-[0-9]{4}$"
          },
          "artifact_kind": {
            "enum": [
              "subtitle_srt",
              "ocr_primary_srt",
              "ocr_validation_srt",
              "reviewed_subtitle_srt"
            ]
          },
          "source": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "raw",
              "derived"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "cue_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "path_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "supports_time_range": {
            "const": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}

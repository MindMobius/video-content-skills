{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/setup-v1.json",
  "title": "Video Subtitle Setup Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "ready",
    "requested_capabilities",
    "configuration",
    "dependencies",
    "agent_actions",
    "human_actions",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "video-subtitle/setup-v1"
    },
    "status": {
      "enum": ["ready", "agent_action_required", "human_action_required"]
    },
    "ready": {"type": "boolean"},
    "requested_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "configuration": {
      "type": "object",
      "required": ["path", "exists", "configured_fields", "precedence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "configured_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "precedence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency_id",
          "kind",
          "description",
          "required_by",
          "status"
        ],
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "tested_version": {"type": "string", "minLength": 1},
          "tested_revision": {"type": "string", "minLength": 1},
          "required_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "status": {
            "enum": ["ready", "missing", "blocked", "human_action_required"]
          },
          "detected": {
            "type": ["string", "number", "boolean", "null"]
          },
          "blocked_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "runtime_checked": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "agent_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "human_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "next_step": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": ["dependency_id", "type", "description"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "format": "uri"},
        "confirmation_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}

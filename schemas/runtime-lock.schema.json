{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/runtime-lock-v1.json",
  "title": "Video Subtitle Runtime Lock v1",
  "type": "object",
  "required": ["schema_version", "verified_at", "ffmpeg", "videocr", "asr", "models"],
  "properties": {
    "schema_version": { "const": "video-subtitle/runtime-lock-v1" },
    "verified_at": { "type": "string", "format": "date" },
    "ffmpeg": {
      "type": "object",
      "required": ["minimum_major", "tested_version", "verification_argument", "install_hints"],
      "properties": {
        "minimum_major": { "type": "integer", "minimum": 1 },
        "tested_version": { "type": "string", "minLength": 1 },
        "verification_argument": { "type": "string", "minLength": 1 },
        "install_hints": {
          "type": "object",
          "required": ["windows", "linux", "macos"],
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "videocr": {
      "type": "object",
      "required": ["version", "release", "variants"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "format": "uri" },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/download" }
        }
      },
      "additionalProperties": false
    },
    "asr": {
      "type": "object",
      "required": ["python", "qwen_asr", "transformers", "profiles"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "qwen_asr": { "type": "string", "minLength": 1 },
        "transformers": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["torch", "index_url"],
            "properties": {
              "torch": { "type": "string", "minLength": 1 },
              "index_url": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": ["qwen_asr_model", "qwen_aligner_model"],
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "download": {
      "type": "object",
      "required": ["asset", "bytes", "sha256", "url"],
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["repo_id", "revision", "confirmation_required"],
      "properties": {
        "repo_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "confirmation_required": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

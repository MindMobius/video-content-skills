{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/fidelity-audit-v1.json",
  "title": "Video Content Fidelity Audit v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_manifest_sha256",
    "content_map_sha256",
    "target",
    "status",
    "claim_checks",
    "required_element_checks",
    "findings",
    "repair_actions"
  ],
  "properties": {
    "schema_version": { "const": "video-content/fidelity-audit-v1" },
    "project_id": { "type": "string", "pattern": "^content_[a-f0-9]{16}$" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "content_map_sha256": { "$ref": "#/$defs/sha256" },
    "target": {
      "type": "object",
      "required": ["deliverable_id", "sha256"],
      "properties": {
        "deliverable_id": { "type": "string", "pattern": "^dlv-[0-9]{3}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["pass", "pass_with_warnings", "fail"] },
    "claim_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "claim_ids", "verdict", "notes"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^claim-[0-9]{4}$" }
          },
          "verdict": {
            "enum": ["faithful", "compressed_but_faithful", "distorted", "unsupported"]
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "required_element_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element_type", "element_id", "present", "notes"],
        "properties": {
          "element_type": { "enum": ["claim", "caveat"] },
          "element_id": { "type": "string" },
          "present": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "message"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^finding-[0-9]{4}$" },
          "severity": { "enum": ["warning", "error"] },
          "category": {
            "enum": [
              "unsupported_claim",
              "distortion",
              "missing_context",
              "missing_caveat",
              "uncertainty_hidden",
              "attribution",
              "translation",
              "other"
            ]
          },
          "message": { "type": "string", "minLength": 1 },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^claim-[0-9]{4}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "repair_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "instruction"],
        "properties": {
          "priority": { "enum": ["required", "recommended"] },
          "instruction": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/content-project-v1.json",
  "title": "Video Content Project v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "created_at",
    "updated_at",
    "status",
    "intent",
    "source",
    "artifacts",
    "current",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "video-content/project-v1" },
    "project_id": {
      "type": "string",
      "pattern": "^content_[a-f0-9]{16}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "initialized",
        "mapped",
        "planned",
        "drafted",
        "needs_revision",
        "complete"
      ]
    },
    "intent": {
      "type": "object",
      "required": ["objective", "audience", "output_language"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "audience": { "type": "string" },
        "output_language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "manifest_path",
        "manifest_sha256",
        "job_id",
        "video",
        "evidence"
      ],
      "properties": {
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "job_id": { "type": ["string", "null"] },
        "video": { "type": "object" },
        "selected_source": { "type": ["object", "null"] },
        "review": { "type": ["object", "null"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "content_maps",
        "media_plans",
        "deliverables",
        "fidelity_audits"
      ],
      "properties": {
        "content_maps": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "media_plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "deliverables": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "fidelity_audits": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": [
        "content_map_id",
        "media_plan_id",
        "deliverable_id",
        "fidelity_audit_id"
      ],
      "properties": {
        "content_map_id": { "type": ["string", "null"] },
        "media_plan_id": { "type": ["string", "null"] },
        "deliverable_id": { "type": ["string", "null"] },
        "fidelity_audit_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "artifact_kind",
        "source",
        "source_kind",
        "layer",
        "selected",
        "path",
        "sha256"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^ev-[0-9]{4}$" },
        "artifact_kind": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "source_kind": { "type": ["string", "null"] },
        "layer": { "enum": ["raw", "derived"] },
        "selected": { "type": "boolean" },
        "cue_count": { "type": ["integer", "null"], "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "kind", "revision", "path", "sha256", "created_at"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-content/evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "job_id", "source", "observations", "artifact_refs", "decision", "created_at"],
  "properties": {
    "schema_version": {"const": "video-content/evidence-v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "artifact_refs": {"type": "array", "items": {"type": "object"}},
    "decision": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  }
}

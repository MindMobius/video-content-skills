{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/ocr-scout-plan-v1.json",
  "title": "Hard Subtitle OCR Scout Plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "duration_seconds",
    "requested_window_seconds",
    "effective_window_seconds",
    "requested_anchors",
    "raw_window_count",
    "window_count",
    "windows",
    "coverage_seconds",
    "coverage_ratio",
    "estimated_full_ocr_savings_ratio",
    "decision_boundary"
  ],
  "properties": {
    "schema_version": { "const": "video-subtitle/ocr-scout-plan-v1" },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "requested_window_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "effective_window_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "requested_anchors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "uniqueItems": true
    },
    "raw_window_count": { "type": "integer", "minimum": 1 },
    "window_count": { "type": "integer", "minimum": 1 },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "window_id",
          "start_ms",
          "end_ms",
          "duration_seconds",
          "time_start",
          "time_end",
          "anchors",
          "labels"
        ],
        "properties": {
          "window_id": { "type": "string", "pattern": "^scout-[0-9]{3,}$" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "time_start": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
          },
          "time_end": {
            "type": "string",
            "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "coverage_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "estimated_full_ocr_savings_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision_boundary": {
      "type": "object",
      "required": ["owner", "instruction"],
      "properties": {
        "owner": { "const": "calling_agent" },
        "instruction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

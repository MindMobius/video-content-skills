{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/automation-profile-v1.json",
  "title": "Video Automation Profile v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "enabled",
    "source",
    "content",
    "evidence_policy",
    "retry_policy",
    "draft_authorization_id",
    "prohibited_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "video-automation/profile-v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile[-_][A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "account_profile_alias",
        "poll_interval_seconds"
      ],
      "properties": {
        "kind": {
          "const": "bilibili_watch_later"
        },
        "account_profile_alias": {
          "type": "string",
          "minLength": 1
        },
        "poll_interval_seconds": {
          "type": "integer",
          "minimum": 60
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": [
        "medium",
        "objective",
        "audience",
        "output_language",
        "style",
        "image_policy"
      ],
      "properties": {
        "medium": {
          "const": "wechat_article"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "output_language": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "image_policy": {
          "const": "source_video_only"
        }
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "require_hard_subtitle_assessment",
        "allow_platform_subtitle",
        "allow_hard_ocr",
        "allow_audio_asr"
      ],
      "properties": {
        "require_hard_subtitle_assessment": {
          "const": true
        },
        "allow_platform_subtitle": {
          "type": "boolean"
        },
        "allow_hard_ocr": {
          "type": "boolean"
        },
        "allow_audio_asr": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "retry_policy": {
      "type": "object",
      "required": [
        "max_technical_attempts",
        "max_content_repairs",
        "backoff_seconds"
      ],
      "properties": {
        "max_technical_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_content_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "backoff_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "draft_authorization_id": {
      "type": "string",
      "pattern": "^auth[-_][A-Za-z0-9_-]+$"
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "publish",
          "mass_send",
          "schedule",
          "originality",
          "account_management"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "publish"
          }
        },
        {
          "contains": {
            "const": "mass_send"
          }
        },
        {
          "contains": {
            "const": "schedule"
          }
        },
        {
          "contains": {
            "const": "originality"
          }
        },
        {
          "contains": {
            "const": "account_management"
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

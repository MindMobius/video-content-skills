{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/review-decisions-v1.json",
  "title": "Video Subtitle Review Submission v1",
  "type": "object",
  "required": [
    "windows"
  ],
  "properties": {
    "schema_version": {
      "const": "video-subtitle/review-submission-v1"
    },
    "reviewer": {
      "type": "string"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "window_id",
          "decisions"
        ],
        "properties": {
          "window_id": {
            "type": "string",
            "pattern": "^rw-[0-9]{4}$"
          },
          "notes": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/decision"
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unresolved"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "cue_id": {
          "type": "string"
        },
        "action": {
          "enum": [
            "keep",
            "replace",
            "delete",
            "insert"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "default": "high"
        },
        "original_text": {
          "type": "string"
        },
        "reviewed_text": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "insert"
              }
            }
          },
          "then": {
            "required": [
              "start_ms",
              "end_ms",
              "reviewed_text",
              "reason"
            ]
          },
          "else": {
            "required": [
              "cue_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "reviewed_text",
              "reason"
            ]
          }
        }
      ]
    },
    "unresolved": {
      "type": "object",
      "required": [
        "issue"
      ],
      "properties": {
        "cue_id": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

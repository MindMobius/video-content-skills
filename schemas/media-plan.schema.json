{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/media-plan-v1.json",
  "title": "Video Content Media Plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_manifest_sha256",
    "content_map_sha256",
    "communication_goal",
    "audience",
    "content_topology",
    "selected_medium",
    "selection_reason",
    "alternatives",
    "required_claim_ids",
    "required_caveat_ids",
    "omissions",
    "structure",
    "rendering_contract",
    "fidelity_rules"
  ],
  "properties": {
    "schema_version": { "const": "video-content/media-plan-v1" },
    "project_id": { "type": "string", "pattern": "^content_[a-f0-9]{16}$" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "content_map_sha256": { "$ref": "#/$defs/sha256" },
    "communication_goal": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "content_topology": {
      "type": "object",
      "required": [
        "argument_depth",
        "context_dependency",
        "visual_potential",
        "uncertainty_level"
      ],
      "properties": {
        "argument_depth": { "enum": ["low", "medium", "high"] },
        "context_dependency": { "enum": ["low", "medium", "high"] },
        "visual_potential": { "enum": ["low", "medium", "high"] },
        "uncertainty_level": { "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "selected_medium": { "$ref": "#/$defs/medium" },
    "selection_reason": { "type": "string", "minLength": 1 },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["medium", "rejected_because"],
        "properties": {
          "medium": { "$ref": "#/$defs/medium" },
          "rejected_because": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "required_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim_id" }
    },
    "required_caveat_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/caveat_id" }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "reason"],
        "properties": {
          "claim_id": { "$ref": "#/$defs/claim_id" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "purpose", "claim_ids", "caveat_ids", "visual_direction"],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^unit-[0-9]{4}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claim_id" } },
          "caveat_ids": { "type": "array", "items": { "$ref": "#/$defs/caveat_id" } },
          "visual_direction": { "type": "string" },
          "approximate_chars": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "rendering_contract": {
      "type": "object",
      "required": ["format", "tone", "length_or_dimensions", "accessibility"],
      "properties": {
        "format": { "enum": ["markdown", "html", "svg", "json", "text"] },
        "tone": { "type": "string", "minLength": 1 },
        "length_or_dimensions": { "type": "string", "minLength": 1 },
        "accessibility": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "fidelity_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim_id": { "type": "string", "pattern": "^claim-[0-9]{4}$" },
    "caveat_id": { "type": "string", "pattern": "^caveat-[0-9]{4}$" },
    "medium": {
      "enum": ["article", "one_page", "card_series", "brief", "script", "custom"]
    }
  },
  "additionalProperties": false
}

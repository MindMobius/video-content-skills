{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-content/transcript-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transcript_id", "job_id", "evidence_ids", "cues", "text", "corrections", "uncertainties", "quality", "created_at"],
  "properties": {
    "schema_version": {"const": "video-content/transcript-v1"},
    "transcript_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cues": {"type": "array", "items": {"type": "object"}},
    "text": {"type": "string"},
    "corrections": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "items": {"type": "object"}},
    "quality": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  }
}

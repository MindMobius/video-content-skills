{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/portable-bundle-v1.json",
  "title": "Video Content Portable Bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "project_id",
    "project_entry",
    "files",
    "excluded",
    "secret_scan",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "video-content/portable-bundle-v1" },
    "bundle_id": { "type": "string", "pattern": "^bundle_[a-f0-9]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "project_id": { "type": "string", "minLength": 1 },
    "project_entry": { "type": "string", "pattern": "^workspace/" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^workspace/" },
          "role": { "enum": ["project", "manifest", "evidence", "extra"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reason"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "secret_scan": {
      "type": "object",
      "required": ["passed", "files_scanned", "patterns"],
      "properties": {
        "passed": { "const": true },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "patterns": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}

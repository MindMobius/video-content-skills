    "transcript_id": {"type": "string", "minLength": 1},
    "carrier": {"type": "string", "minLength": 1},
    "document": {"type": "object"},
    "media": {"type": "array", "items": {"type": "object"}},
    "audit": {"type": "object"},
    "artifact_refs": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-content/job-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "idempotency_key", "source", "stage", "status", "attempts", "artifact_refs", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "video-content/job-v1"},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "profile_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "stage": {"enum": ["queued", "inspecting", "evidence", "transcript", "content", "handoff", "completed"]},
    "status": {"enum": ["queued", "running", "retryable", "paused_auth", "unprocessable", "completed", "failed"]},
    "attempts": {"type": "integer", "minimum": 0},
    "retry_at": {"type": ["string", "null"]},
    "last_error": {"type": ["object", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": ["string", "null"]}
  }
}

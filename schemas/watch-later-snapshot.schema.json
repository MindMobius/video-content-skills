{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/watch-later-snapshot-v1.json",
  "title": "Bilibili Watch Later Snapshot v1",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "profile_id",
    "account_profile_alias",
    "entries",
    "new_entries",
    "source_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "video-automation/watch-later-snapshot-v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snapshot_[a-f0-9]{16}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile[-_][A-Za-z0-9_-]+$"
    },
    "account_profile_alias": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bvid",
          "page",
          "title",
          "url",
          "position",
          "added_at"
        ],
        "properties": {
          "bvid": {
            "type": "string",
            "minLength": 3
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.bilibili\\.com/video/[^?]+/?$"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "added_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "new_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bvid",
          "page",
          "title",
          "url",
          "position",
          "added_at"
        ],
        "properties": {
          "bvid": {
            "type": "string",
            "minLength": 3
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://www\\.bilibili\\.com/video/[^?]+/?$"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "added_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

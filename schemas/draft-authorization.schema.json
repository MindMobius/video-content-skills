{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-subtitle.local/schemas/draft-authorization-v1.json",
  "title": "Standing WeChat Draft Authorization v1",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_id",
    "status",
    "profile_ids",
    "browser_profile_alias",
    "allowed_actions",
    "prohibited_actions",
    "created_at",
    "expires_at",
    "revoked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "video-automation/draft-authorization-v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^auth[-_][A-Za-z0-9_-]+$"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^profile[-_][A-Za-z0-9_-]+$"
      }
    },
    "browser_profile_alias": {
      "type": "string",
      "minLength": 1
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "const": "save_wechat_draft"
        }
      ],
      "items": false
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "publish",
          "mass_send",
          "schedule",
          "originality",
          "account_management"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "publish"
          }
        },
        {
          "contains": {
            "const": "mass_send"
          }
        },
        {
          "contains": {
            "const": "schedule"
          }
        },
        {
          "contains": {
            "const": "originality"
          }
        },
        {
          "contains": {
            "const": "account_management"
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        }
      },
      "then": {
        "properties": {
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
